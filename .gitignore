# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# Locally-built Sunbiz index (v3 Phase 3). Regenerated from LaCie cordata
# via `npx tsx scripts/build-sunbiz-index.ts`. Not committed — 4.7 MB now,
# host-local, always rebuildable, and treated as stale after 45 days.
/data/sunbiz.sqlite
/data/sunbiz.sqlite.building

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local CAMA / PBC analysis outputs (bulk data files excluded)
/scripts/output/*.json
/scripts/output/*.csv
/scripts/output/dry-run-emails.txt
/scripts/output/lighthouse*

# Google OAuth credentials — never commit these
scripts/credentials.json
scripts/gmail-token.json
.tmp/
logs/
