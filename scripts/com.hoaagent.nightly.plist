<?xml version="1.0" encoding="UTF-8"?>
<!--
  com.hoaagent.nightly.plist
  v3 nightly-enrich job. Fires once a day at 02:00 America/New_York.
  Install:
    cp scripts/com.hoaagent.nightly.plist ~/Library/LaunchAgents/
    launchctl load ~/Library/LaunchAgents/com.hoaagent.nightly.plist
  Uninstall:
    launchctl unload ~/Library/LaunchAgents/com.hoaagent.nightly.plist
    rm ~/Library/LaunchAgents/com.hoaagent.nightly.plist
  Logs land at ~/Library/Logs/hoaagent/nightly-enrich.{out,err}.log
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.hoaagent.nightly</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>-lc</string>
    <string>cd /Users/izzymartinez/Projects/hoa-agent &amp;&amp; set -a &amp;&amp; source .env.local &amp;&amp; set +a &amp;&amp; /usr/local/bin/npx tsx scripts/nightly-enrich.ts</string>
  </array>

  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>2</integer>
    <key>Minute</key>
    <integer>0</integer>
  </dict>

  <key>RunAtLoad</key>
  <false/>

  <key>StandardOutPath</key>
  <string>/Users/izzymartinez/Library/Logs/hoaagent/nightly-enrich.out.log</string>

  <key>StandardErrorPath</key>
  <string>/Users/izzymartinez/Library/Logs/hoaagent/nightly-enrich.err.log</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
    <key>HOME</key>
    <string>/Users/izzymartinez</string>
  </dict>
</dict>
</plist>
