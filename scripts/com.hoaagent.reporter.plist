<?xml version="1.0" encoding="UTF-8"?>
<!--
  com.hoaagent.reporter.plist
  Sends the daily HOA Agent report as one iMessage at 07:00 local.
  Reads job_runs / change_log / job_health only — no community data
  reads beyond COUNT (owner ruling 2026-09-09).

  Install:
    cp scripts/com.hoaagent.reporter.plist ~/Library/LaunchAgents/
    launchctl load ~/Library/LaunchAgents/com.hoaagent.reporter.plist
  Uninstall:
    launchctl unload ~/Library/LaunchAgents/com.hoaagent.reporter.plist
    rm ~/Library/LaunchAgents/com.hoaagent.reporter.plist
  Logs:
    ~/Library/Logs/hoaagent/reporter.{out,err}.log
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.hoaagent.reporter</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>-lc</string>
    <string>cd /Users/izzymartinez/Projects/hoa-agent &amp;&amp; set -a &amp;&amp; source .env.local &amp;&amp; set +a &amp;&amp; /usr/local/bin/npx tsx scripts/reporter.ts</string>
  </array>

  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>7</integer>
    <key>Minute</key>
    <integer>0</integer>
  </dict>

  <key>RunAtLoad</key>
  <false/>

  <key>StandardOutPath</key>
  <string>/Users/izzymartinez/Library/Logs/hoaagent/reporter.out.log</string>

  <key>StandardErrorPath</key>
  <string>/Users/izzymartinez/Library/Logs/hoaagent/reporter.err.log</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
    <key>HOME</key>
    <string>/Users/izzymartinez</string>
  </dict>
</dict>
</plist>
