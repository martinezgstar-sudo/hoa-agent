{"name": "hoa", "baseSelector": ".container, [class*='property'], [class*='listing'], [role='main']", "fields": [{"name": "management_company", "selector": "[data-mgmt], .management-company, .hoa-company, .managed-by, h2:contains('Management')", "type": "text"}, {"name": "phone", "selector": "a[href^='tel:'], [data-phone], .phone-number, .contact-phone", "type": "text"}, {"name": "email", "selector": "a[href^='mailto:'], [data-email], .email-address, .contact-email", "type": "text"}, {"name": "fee", "selector": "[data-hoa-fee], .hoa-fee, .monthly-fee, .association-fee, [class*='fee-amount']", "type": "text"}, {"name": "units", "selector": "[data-units], .total-units, .unit-count, [class*='units']", "type": "text"}, {"name": "amenities", "selector": "[data-amenities], .amenities, .facilities, ul.amenities li, [class*='amenity']", "type": "text"}, {"name": "website", "selector": "[data-website], a.hoa-website, .community-website, .website-link", "type": "text"}]}